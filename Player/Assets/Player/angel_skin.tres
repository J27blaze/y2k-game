code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec4 skin_colour : source_color = vec4(0.485935, 0.478650, 0.472404, 1.000000);
uniform sampler2D tex_frg_7;
uniform sampler2D tex_frg_10;



void fragment() {
// ColorParameter:8
	vec4 n_out8p0 = skin_colour;


// ColorOp:3
	vec3 n_in3p1 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_out3p0 = vec3(1.0) - (vec3(1.0) - vec3(n_out8p0.xyz)) * (vec3(1.0) - n_in3p1);


// Texture2D:7
	vec4 n_out7p0 = texture(tex_frg_7, UV);


// VectorOp:4
	vec3 n_out4p0 = n_out3p0 * vec3(n_out7p0.xyz);


// Texture2D:10
	vec4 n_out10p0 = texture(tex_frg_10, UV);
	float n_out10p4 = n_out10p0.a;


// Mix:11
	vec3 n_out11p0 = mix(n_out4p0, vec3(n_out10p0.xyz), vec3(n_out10p4));


// Output:0
	ALBEDO = n_out11p0;


}
