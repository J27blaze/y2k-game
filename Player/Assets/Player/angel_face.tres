code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec4 skin_colour : source_color = vec4(0.861377, 0.000002, 0.479335, 1.000000);
uniform sampler2D skin_map : filter_nearest;
uniform sampler2D iris_map : filter_nearest;
uniform vec4 iris_colour : source_color = vec4(0.000000, 1.000000, 0.083333, 1.000000);



void fragment() {
// ColorParameter:8
	vec4 n_out8p0 = skin_colour;


// ColorOp:3
	vec3 n_in3p1 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_out3p0 = vec3(1.0) - (vec3(1.0) - vec3(n_out8p0.xyz)) * (vec3(1.0) - n_in3p1);


	vec4 n_out7p0;
// Texture2D:7
	n_out7p0 = texture(skin_map, UV);


// VectorOp:4
	vec3 n_out4p0 = n_out3p0 * vec3(n_out7p0.xyz);


// Mix:11
	vec3 n_in11p1 = vec3(1.00000, 1.00000, 1.00000);
	vec3 n_in11p2 = vec3(0.50000, 0.50000, 0.50000);
	vec3 n_out11p0 = mix(n_out4p0, n_in11p1, n_in11p2);


	vec4 n_out15p0;
// Texture2D:15
	n_out15p0 = texture(iris_map, UV);
	float n_out15p4 = n_out15p0.a;


// ColorParameter:17
	vec4 n_out17p0 = iris_colour;


	vec3 n_out18p0;
// ColorOp:18
	{
		float base = vec3(n_out15p0.xyz).x;
		float blend = vec3(n_out17p0.xyz).x;
		if (base < 0.5) {
			n_out18p0.x = 2.0 * base * blend;
		} else {
			n_out18p0.x = 1.0 - 2.0 * (1.0 - blend) * (1.0 - base);
		}
	}
	{
		float base = vec3(n_out15p0.xyz).y;
		float blend = vec3(n_out17p0.xyz).y;
		if (base < 0.5) {
			n_out18p0.y = 2.0 * base * blend;
		} else {
			n_out18p0.y = 1.0 - 2.0 * (1.0 - blend) * (1.0 - base);
		}
	}
	{
		float base = vec3(n_out15p0.xyz).z;
		float blend = vec3(n_out17p0.xyz).z;
		if (base < 0.5) {
			n_out18p0.z = 2.0 * base * blend;
		} else {
			n_out18p0.z = 1.0 - 2.0 * (1.0 - blend) * (1.0 - base);
		}
	}


// Mix:14
	vec3 n_out14p0 = mix(n_out11p0, n_out18p0, vec3(n_out15p4));


// Output:0
	ALBEDO = n_out14p0;


}
